# VerifiHireAI Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# --- FRONTEND (React) ---
REACT_APP_ASSEMBLYAI_API_KEY=9df9ae6e7f4a4fcfbf51ef5a3d105997

# DEV ONLY — bypass the secure precheck flow for AI interview testing.
# Set to "false" (or remove this var) to re-enable the full precheck.
REACT_APP_SKIP_PRECHECK=false

# Django Core
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
FRONTEND_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DB_NAME=verifihire
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email (Gmail SMTP - use App Password, not regular password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# DeepSeek AI (Primary LLM)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY_1=your-deepseek-api-key

# Groq AI (Resume Screening Fallback) - Add up to 3 keys for rotation
GROQ_API_KEY_1=your-groq-key-1
GROQ_API_KEY_2=your-groq-key-2
GROQ_API_KEY_3=your-groq-key-3

# AssemblyAI (Speech-to-Text for AI Interviews)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key